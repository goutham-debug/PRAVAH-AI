# --- Required ---
APP_ENV=production
# 32+ chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Supabase > Project Settings > Database > Connection string (Session pooler, port 5432/6543).
# Use the database password you set in Supabase. Never commit this file.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres

# --- First start only: creates the initial System Administrator (must change password at first login).
# Remove both lines after the first successful sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional ---
CORS_ORIGINS=
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Quarantined development data (NOT real). Keep false; true is refused when APP_ENV=production.
LOAD_PILOT_DATASET=false
PORT=5000

# --- Study area / data operations ---
# South,West,North,East bounding box used for OpenStreetMap road extraction.
STUDY_BBOX=12.90,77.66,13.03,77.82
# 0 = manual refresh only. >0 = background refresh of configured providers every N minutes.
INGEST_INTERVAL_MINUTES=0
# Where downloaded provider files are stored (default backend/data/ingested; not committed).
# INGEST_DIR=

# --- Authorised provider access (leave blank until access is granted; the adapter reports NOT_CONFIGURED) ---
IMD_URL=
IMD_API_KEY=
# IMD_AUTH_HEADER=Authorization
# IMD_FORMAT=json
# IMD_OBSERVED_FIELD=
KSNDMC_URL=
KSNDMC_API_KEY=
CWC_URL=
CWC_API_KEY=
GBA_URL=
GBA_FORMAT=geojson
BHUVAN_URL=
BHUVAN_API_KEY=
BHUVAN_FORMAT=geojson
