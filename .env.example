# ==============================================================================
# PRAVAH AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` in backend/ or root directory. NEVER commit `.env` with secrets.
# ==============================================================================

# --- Core Application Security ---
APP_ENV=development
# 32+ character random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-32-char-key-in-production
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

# --- Database Storage ---
# In development, defaults to SQLite (pravah_dev.db).
# For production PostGIS (Supabase/AWS RDS):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///pravah_dev.db

# --- Initial Bootstrap Administrator (First Boot Only) ---
# Creates initial administrator account (forced to change password upon first login).
# Set a unique password locally before first startup.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=

# --- Pilot Quarantine Dataset ---
# Set to 'true' in development to load Mahadevapura pilot datasets from backend/data/dev_quarantine/.
# Automatically blocked in production mode.
LOAD_PILOT_DATASET=true

# --- Geographic Pilot Study Zone (Mahadevapura, Bengaluru) ---
STUDY_BBOX=12.90,77.66,13.03,77.82
PILOT_LAT=12.9698
PILOT_LON=77.7499
PILOT_ZONE=Whitefield-Mahadevapura, Bengaluru (BBMP)

# --- Ingestion Scheduler ---
# 0 = Manual/On-demand refresh only. >0 = Background thread periodic refresh (minutes).
INGEST_INTERVAL_MINUTES=0

# ==============================================================================
# EXTERNAL DATA PROVIDERS CONFIGURATION
# Leave blank if credentials have not yet been granted.
# Services will return explicit UNAVAILABLE status — never fake/substitute data.
# ==============================================================================

# 1. Open-Meteo Weather API (No key required for non-commercial evaluation)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# 2. KSNDMC (Karnataka State Natural Disaster Monitoring Centre) AWS Network
# Register at: https://ksndmc.org (Requires Karnataka Govt departmental MoU)
KSNDMC_URL=https://ksndmc.org/api/v1/aws/rainfall
KSNDMC_API_KEY=

# 3. IMD (India Meteorological Department) District Weather Observations
# Register at: https://imd.gov.in / https://mausam.imd.gov.in
IMD_URL=https://api.imd.gov.in/v1/weather/observations
IMD_API_KEY=

# 4. Central Water Commission (CWC) Flood Inundation & River Basins
CWC_URL=https://ffs.india-water.gov.in/api
CWC_API_KEY=

# 5. ISRO Bhuvan Geo-Portal (CartoDEM & Indian Remote Sensing Data)
# Register at: https://bhuvan.nrsc.gov.in
BHUVAN_URL=https://bhuvan.nrsc.gov.in/api/v1/dem
BHUVAN_API_KEY=

# 6. AI Assistant LLM Integration (Optional)
# If left blank, PRAVAH AI Assistant operates in deterministic grounded-synthesis mode.
OPENAI_API_KEY=
GEMINI_API_KEY=
